@model Securityzator.Web.Models.Home.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h1 class="page-title">@Model.WorkspaceName</h1>
    <div class="page-actions">
        <a class="btn btn-primary btn-sm" asp-controller="Remediations" asp-action="Index">
            <i class="bi bi-lightning-charge me-1"></i>Queue quick win
        </a>
        <a class="btn btn-outline-light btn-sm" asp-controller="Jobs" asp-action="Index">
            <i class="bi bi-clock-history me-1"></i>Jobs
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-tile">
            <div class="stat-tile-icon c-accent"><i class="bi bi-cloud-check"></i></div>
            <div>
                <div class="stat-tile-value">@Model.ValidatedConnectionCount</div>
                <div class="stat-tile-label">Validated tenants</div>
                @if (Model.ConnectionValidationFailureCount > 0)
                {
                    <div class="stat-tile-detail">@Model.ConnectionValidationFailureCount need follow-up</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-tile">
            <div class="stat-tile-icon @(Model.ActiveJobCount > 0 ? "c-warn" : "c-success")"><i class="bi bi-gear"></i></div>
            <div>
                <div class="stat-tile-value">@Model.ActiveJobCount</div>
                <div class="stat-tile-label">Active jobs</div>
                @if (Model.JobsNeedingAttentionCount > 0)
                {
                    <div class="stat-tile-detail">@Model.JobsNeedingAttentionCount failed or retrying</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-tile">
            <div class="stat-tile-icon c-accent"><i class="bi bi-shield-check"></i></div>
            <div>
                <div class="stat-tile-value">@Model.RecommendationReadyConnectionCount</div>
                <div class="stat-tile-label">Score-ready tenants</div>
                @if (Model.TotalMappedRecommendationCount > 0)
                {
                    <div class="stat-tile-detail">@Model.TotalMappedRecommendationCount mapped controls</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-tile">
            <div class="stat-tile-icon @(Model.SecretsNeedingRotationCount > 0 ? "c-danger" : "c-success")"><i class="bi bi-key"></i></div>
            <div>
                <div class="stat-tile-value">@Model.SecretsNeedingRotationCount</div>
                <div class="stat-tile-label">Secrets near rotation</div>
                @if (Model.SecretsPastRotationCount > 0)
                {
                    <div class="stat-tile-detail">@Model.SecretsPastRotationCount past rotation window</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    @if (Model.HasAttentionItems)
    {
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header">
                    <span class="card-title"><i class="bi bi-exclamation-circle me-1"></i>Needs attention</span>
                </div>
                <div class="card-body">
                    <ul class="info-list">
                        @foreach (var item in Model.AttentionItems)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header">
                    <span class="card-title">Platform modules</span>
                </div>
                <div class="card-body p-0">
                    @foreach (var module in Model.Blueprint.Modules)
                    {
                        <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom: 1px solid var(--line);">
                            <span style="font-size:0.875rem; font-weight:500;">@module.Name</span>
                            <span class="status-badge @(module.Status == "Live" ? "success" : module.Status == "Planned" ? "idle" : "running")">@module.Status</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <span class="card-title">Platform modules</span>
                </div>
                <div class="card-body p-0">
                    <div class="row g-0">
                        @foreach (var module in Model.Blueprint.Modules)
                        {
                            <div class="col-sm-6 col-lg-4">
                                <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom: 1px solid var(--line); border-right: 1px solid var(--line);">
                                    <span style="font-size:0.875rem; font-weight:500;">@module.Name</span>
                                    <span class="status-badge @(module.Status == "Live" ? "success" : module.Status == "Planned" ? "idle" : "running")">@module.Status</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.HasCoverage)
{
    <div class="content-section">
        <div class="row g-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Coverage</span>
                        <span class="text-muted" style="font-size:0.78rem;">@Model.TotalRunnableRecommendationCount of @Model.TotalMappedRecommendationCount mapped controls runnable now</span>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-sm-4">
                                <div class="summary-stat">
                                    <div class="meta-label">Mapped</div>
                                    <div class="summary-value">@Model.TotalMappedRecommendationCount</div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="summary-stat">
                                    <div class="meta-label">Runnable</div>
                                    <div class="summary-value">@Model.TotalRunnableRecommendationCount</div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="summary-stat">
                                    <div class="meta-label">Drift</div>
                                    <div class="summary-value">@Model.TotalMappingDriftCount</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
