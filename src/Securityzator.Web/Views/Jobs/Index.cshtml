@using Securityzator.Application.Remediations
@using Securityzator.Application.Jobs
@using Securityzator.Application.Workers
@model Securityzator.Web.Models.Jobs.JobsPageViewModel
@{
    ViewData["Title"] = "Jobs";
}

@functions {
    private static string GetJobStatusClass(RemediationJobStatus status) => status switch
    {
        RemediationJobStatus.Succeeded => "success",
        RemediationJobStatus.Failed => "failed",
        RemediationJobStatus.Running => "running",
        RemediationJobStatus.RetryScheduled => "retry",
        _ => "idle"
    };

    private static string GetStatusClass(RemediationRunStatus status) => status switch
    {
        RemediationRunStatus.Succeeded => "success",
        RemediationRunStatus.Failed => "failed",
        _ => "retry"
    };

    private static string GetWorkerStatusClass(WorkerExecutionState state, bool isStale)
    {
        if (isStale) return "failed";
        return state switch
        {
            WorkerExecutionState.Processing => "running",
            WorkerExecutionState.Starting => "retry",
            WorkerExecutionState.Stopped => "idle",
            _ => "success"
        };
    }

    private static string GetWorkerStatusLabel(WorkerExecutionState state, bool isStale)
    {
        if (isStale) return "Stale";
        return state switch
        {
            WorkerExecutionState.Processing => "Processing",
            WorkerExecutionState.Starting => "Starting",
            WorkerExecutionState.Stopped => "Stopped",
            _ => "Healthy"
        };
    }
}

<div class="page-header">
    <h1 class="page-title">Execution history</h1>
    <div class="page-actions">
        <span class="shell-pill">@Model.WorkspaceName</span>
    </div>
</div>

<div class="content-section">
    <div class="d-flex align-items-center gap-2 mb-3">
        <span style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);">Workers</span>
    </div>

    @if (!Model.Workers.Any())
    {
        <div class="card">
            <div class="card-body empty-state">
                <i class="bi bi-cpu" style="font-size:2rem;color:var(--muted);"></i>
                <p class="mt-2 mb-0" style="color:var(--muted);">No worker heartbeat yet. Start the worker host and this section will show heartbeat freshness and active job state.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var worker in Model.Workers)
            {
                <div class="info-card connection-card">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="card-kicker">@worker.WorkerName</div>
                        <span class="status-badge @GetWorkerStatusClass(worker.State, worker.IsStale)">@GetWorkerStatusLabel(worker.State, worker.IsStale)</span>
                    </div>
                    <div class="connection-meta">
                        <div class="meta-row">
                            <div class="meta-label">Heartbeat</div>
                            <div class="meta-value">@worker.LastHeartbeatUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                        </div>
                        <div class="meta-row">
                            <div class="meta-label">Started</div>
                            <div class="meta-value">@worker.StartedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                        </div>
                        <div class="meta-row">
                            <div class="meta-label">Current job</div>
                            <div class="meta-value">
                                @(worker.CurrentJobId.HasValue ? worker.CurrentJobId.Value.ToString() : "Idle")
                                @if (!string.IsNullOrWhiteSpace(worker.CurrentConnectionDisplayName))
                                {
                                    <div class="table-subtext">@worker.CurrentConnectionDisplayName</div>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(worker.LastSummary))
                        {
                            <div class="meta-row">
                                <div class="meta-label">Last summary</div>
                                <div class="meta-value pre-wrap">@worker.LastSummary</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(worker.LastError))
                        {
                            <div class="meta-row">
                                <div class="meta-label">Last error</div>
                                <div class="meta-value pre-wrap" style="color:var(--danger-text);">@worker.LastError</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (Model.RecommendationCoverageSummaries.Any(s => s.HasSnapshot))
{
    <div class="content-section">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);">Recommendation coverage</span>
        </div>
        <div class="card-grid connection-grid">
            @foreach (var coverage in Model.RecommendationCoverageSummaries.Where(s => s.HasSnapshot))
            {
                <div class="info-card recommendation-connection-card">
                    <div class="card-kicker">@coverage.ConnectionDisplayName</div>
                    <div class="table-subtext mb-2">Snapshot @(coverage.LastSuccessUtc.HasValue ? coverage.LastSuccessUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Not yet synced")</div>
                    <div class="summary-grid">
                        <div class="summary-stat"><div class="meta-label">Mapped</div><div class="summary-value">@coverage.MappedControls</div></div>
                        <div class="summary-stat"><div class="meta-label">Runnable</div><div class="summary-value">@coverage.RunnableControls</div></div>
                        <div class="summary-stat"><div class="meta-label">Broader</div><div class="summary-value">@coverage.MappedFamilyControls</div></div>
                        <div class="summary-stat"><div class="meta-label">Drift</div><div class="summary-value">@coverage.MappingDriftControls</div></div>
                    </div>
                    @if (coverage.TopTemplateBuckets.Any())
                    {
                        <div class="template-block">
                            <div class="template-heading">Top families</div>
                            <ul class="info-list compact">
                                @foreach (var bucket in coverage.TopTemplateBuckets.Take(3))
                                {
                                    <li>@bucket.TemplateName: @bucket.ControlCount</li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="form-actions compact">
                        <a class="btn btn-outline-light btn-sm" asp-controller="Recommendations" asp-action="Index" asp-route-connectionId="@coverage.ConnectionId">Open snapshot</a>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="content-section">
    <div class="d-flex align-items-center gap-2 mb-3">
        <span style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);">Queue</span>
    </div>

    @if (!Model.Jobs.Any())
    {
        <div class="card">
            <div class="card-body empty-state">
                <i class="bi bi-inbox" style="font-size:2rem;color:var(--muted);"></i>
                <p class="mt-2 mb-0" style="color:var(--muted);">No jobs queued yet. Queue a remediation to start building the execution trail.</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-card">
            <table class="table table-dark align-middle mb-0 recommendation-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Job</th>
                        <th>Progress</th>
                        <th>Timing</th>
                        <th>Latest detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Jobs)
                    {
                        <tr>
                            <td><span class="status-badge @GetJobStatusClass(job.Status)">@job.Status</span></td>
                            <td>
                                <div class="fw-semibold">@job.TemplateName</div>
                                <div class="table-subtext">@job.ConnectionDisplayName</div>
                            </td>
                            <td>
                                <div>Attempt @job.AttemptCount / @job.MaxAttempts</div>
                                <div class="table-subtext">@job.LaunchMode</div>
                                <div class="table-subtext">Include: @(string.IsNullOrWhiteSpace(job.IncludeGroupId) ? "All users" : job.IncludeGroupId)</div>
                                @if (!string.IsNullOrWhiteSpace(job.ExcludeGroupId))
                                {
                                    <div class="table-subtext">Exclude: @job.ExcludeGroupId</div>
                                }
                            </td>
                            <td>
                                <div>@job.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                @if (job.StartedUtc.HasValue) { <div class="table-subtext">Started @job.StartedUtc.Value.ToLocalTime().ToString("HH:mm")</div> }
                                @if (job.NextAttemptUtc.HasValue && job.Status == RemediationJobStatus.RetryScheduled) { <div class="table-subtext">Retry @job.NextAttemptUtc.Value.ToLocalTime().ToString("HH:mm")</div> }
                                @if (job.CompletedUtc.HasValue) { <div class="table-subtext">Done @job.CompletedUtc.Value.ToLocalTime().ToString("HH:mm")</div> }
                            </td>
                            <td>
                                <div>@(job.Logs.LastOrDefault() ?? job.LastError ?? "—")</div>
                                @if (!string.IsNullOrWhiteSpace(job.PolicyId)) { <div class="table-subtext">Policy: @job.PolicyId</div> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="content-section">
    <div class="d-flex align-items-center gap-2 mb-3">
        <span style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);">Completed runs</span>
    </div>

    @if (!Model.Runs.Any())
    {
        <div class="card">
            <div class="card-body empty-state">
                <i class="bi bi-check2-circle" style="font-size:2rem;color:var(--muted);"></i>
                <p class="mt-2 mb-0" style="color:var(--muted);">No completed runs yet.</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-card">
            <table class="table table-dark align-middle mb-0 recommendation-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Template</th>
                        <th>Connection</th>
                        <th>When</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in Model.Runs)
                    {
                        <tr>
                            <td><span class="status-badge @GetStatusClass(run.Status)">@run.Status</span></td>
                            <td>
                                <div class="fw-semibold">@run.TemplateName</div>
                                <div class="table-subtext">@run.TemplateKey</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@run.ConnectionDisplayName</div>
                                <div class="table-subtext">@run.LaunchMode</div>
                                <div class="table-subtext">Include: @(run.IncludeGroupName ?? (string.IsNullOrWhiteSpace(run.IncludeGroupId) ? "All users" : run.IncludeGroupId))</div>
                                @if (!string.IsNullOrWhiteSpace(run.ExcludeGroupId)) { <div class="table-subtext">Exclude: @(run.ExcludeGroupName ?? run.ExcludeGroupId)</div> }
                            </td>
                            <td>
                                <div>@run.CompletedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                <div class="table-subtext">@run.LaunchedByOperatorName</div>
                            </td>
                            <td>
                                <div>@run.Summary</div>
                                @if (!string.IsNullOrWhiteSpace(run.PolicyId)) { <div class="table-subtext">Policy: @run.PolicyId</div> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
