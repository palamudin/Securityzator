@using Securityzator.Application.Remediations
@using Securityzator.Application.Jobs
@using Securityzator.Application.Workers
@model Securityzator.Web.Models.Jobs.JobsPageViewModel
@{
    ViewData["Title"] = "Jobs";
}

@functions {
    private static string GetJobStatusClass(RemediationJobStatus status)
    {
        return status switch
        {
            RemediationJobStatus.Succeeded => "success",
            RemediationJobStatus.Failed => "failed",
            RemediationJobStatus.Running => "running",
            RemediationJobStatus.RetryScheduled => "retry",
            _ => "idle"
        };
    }

    private static string GetStatusClass(RemediationRunStatus status)
    {
        return status switch
        {
            RemediationRunStatus.Succeeded => "success",
            RemediationRunStatus.Failed => "failed",
            _ => "retry"
        };
    }

    private static string GetWorkerStatusClass(WorkerExecutionState state, bool isStale)
    {
        if (isStale)
        {
            return "failed";
        }

        return state switch
        {
            WorkerExecutionState.Processing => "running",
            WorkerExecutionState.Starting => "retry",
            WorkerExecutionState.Stopped => "idle",
            _ => "success"
        };
    }

    private static string GetWorkerStatusLabel(WorkerExecutionState state, bool isStale)
    {
        if (isStale)
        {
            return "Stale";
        }

        return state switch
        {
            WorkerExecutionState.Processing => "Processing",
            WorkerExecutionState.Starting => "Starting",
            WorkerExecutionState.Stopped => "Stopped",
            _ => "Healthy"
        };
    }
}

<section class="content-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Milestone 6 hardening slice</span>
            <h1>Execution history and audit</h1>
            <p class="section-copy">This page now shows the worker heartbeat alongside queued jobs and completed runs, so operators can tell the difference between a healthy idle queue and a remediation engine that has gone quiet.</p>
        </div>
        <div class="shell-pill">@Model.WorkspaceName</div>
    </div>

    <div class="split-layout">
        <article class="info-card">
            <div class="card-kicker">Worker posture</div>
            <h2>Execution capabilities</h2>
            <ul class="info-list">
                @foreach (var capability in Model.Blueprint.JobCapabilities)
                {
                    <li><strong>@capability.Name:</strong> @capability.Summary</li>
                }
            </ul>
        </article>

        <article class="info-card">
            <div class="card-kicker">Recovery cues</div>
            <h2>What to look for when the queue feels stuck</h2>
            <ul class="info-list">
                <li>A worker marked as <strong>Stale</strong> has not refreshed its heartbeat within the expected window.</li>
                <li>Jobs sitting in <strong>Queued</strong> with no healthy worker usually mean the worker process or service needs attention.</li>
                <li>A worker with a recent heartbeat but repeated last errors points to Graph or credential failures rather than scheduler drift.</li>
                <li>Completed runs still keep the full Graph-side outcome even if the worker has already moved back to idle.</li>
            </ul>
        </article>
    </div>
</section>

<section class="content-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Worker state</span>
            <h2>Background execution heartbeat</h2>
        </div>
    </div>

    @if (!Model.Workers.Any())
    {
        <article class="info-card empty-state">
            <div class="card-kicker">No worker heartbeat yet</div>
            <h3>The queue runner has not reported into shared state</h3>
            <p>Start the worker host or Windows service and this page will begin showing heartbeat freshness, current job activity, and the last known execution summary.</p>
        </article>
    }
    else
    {
        <div class="card-grid">
            @foreach (var worker in Model.Workers)
            {
                <article class="info-card connection-card">
                    <div class="card-kicker">Heartbeat @worker.LastHeartbeatUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                    <h3>@worker.WorkerName</h3>
                    <div class="connection-meta">
                        <div class="meta-row">
                            <div>
                                <div class="meta-label">Status</div>
                                <div class="meta-value">
                                    <span class="status-badge @GetWorkerStatusClass(worker.State, worker.IsStale)">@GetWorkerStatusLabel(worker.State, worker.IsStale)</span>
                                </div>
                            </div>
                        </div>
                        <div class="meta-row">
                            <div>
                                <div class="meta-label">Started</div>
                                <div class="meta-value">@worker.StartedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                            </div>
                        </div>
                        <div class="meta-row">
                            <div>
                                <div class="meta-label">Current job</div>
                                <div class="meta-value">@(worker.CurrentJobId.HasValue ? worker.CurrentJobId.Value.ToString() : "No active job")</div>
                                @if (!string.IsNullOrWhiteSpace(worker.CurrentConnectionDisplayName))
                                {
                                    <div class="table-subtext">@worker.CurrentConnectionDisplayName</div>
                                }
                            </div>
                        </div>
                        <div class="meta-row">
                            <div>
                                <div class="meta-label">Last completion</div>
                                <div class="meta-value">@(worker.LastCompletedUtc.HasValue ? worker.LastCompletedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") : "No completed job yet")</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(worker.LastSummary))
                        {
                            <div class="meta-row">
                                <div>
                                    <div class="meta-label">Last summary</div>
                                    <div class="meta-value pre-wrap">@worker.LastSummary</div>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(worker.LastError))
                        {
                            <div class="meta-row">
                                <div>
                                    <div class="meta-label">Last error</div>
                                    <div class="meta-value pre-wrap">@worker.LastError</div>
                                </div>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="content-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Recommendation coverage</span>
            <h2>How much of each cached tenant snapshot is actionable</h2>
        </div>
    </div>

    @if (!Model.RecommendationCoverageSummaries.Any(summary => summary.HasSnapshot))
    {
        <article class="info-card empty-state">
            <div class="card-kicker">No cached snapshot coverage yet</div>
            <h3>Sync recommendations first to unlock coverage tracking</h3>
            <p>Once a tenant snapshot exists, Securityzator can show how much is runnable now, how much is routed into broader control families, and whether cached mapping keys need a persistence refresh.</p>
        </article>
    }
    else
    {
        <div class="card-grid connection-grid">
            @foreach (var coverage in Model.RecommendationCoverageSummaries.Where(summary => summary.HasSnapshot))
            {
                <article class="info-card recommendation-connection-card">
                    <div class="card-kicker">Snapshot @(coverage.LastSuccessUtc.HasValue ? coverage.LastSuccessUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Not yet synced")</div>
                    <h3>@coverage.ConnectionDisplayName</h3>
                    <div class="summary-grid">
                        <div class="summary-stat">
                            <div class="meta-label">Mapped</div>
                            <div class="summary-value">@coverage.MappedControls</div>
                        </div>
                        <div class="summary-stat">
                            <div class="meta-label">Runnable</div>
                            <div class="summary-value">@coverage.RunnableControls</div>
                        </div>
                        <div class="summary-stat">
                            <div class="meta-label">Broader family</div>
                            <div class="summary-value">@coverage.MappedFamilyControls</div>
                        </div>
                        <div class="summary-stat">
                            <div class="meta-label">Drift</div>
                            <div class="summary-value">@coverage.MappingDriftControls</div>
                        </div>
                    </div>
                    @if (coverage.TopTemplateBuckets.Any())
                    {
                        <div class="template-block">
                            <div class="template-heading">Top mapped families</div>
                            <ul class="info-list compact">
                                @foreach (var bucket in coverage.TopTemplateBuckets.Take(3))
                                {
                                    <li>@bucket.TemplateName: @bucket.ControlCount</li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="form-actions compact">
                        <a class="btn btn-outline-light" asp-controller="Recommendations" asp-action="Index" asp-route-connectionId="@coverage.ConnectionId">Open snapshot</a>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="content-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Queue state</span>
            <h2>Background jobs</h2>
        </div>
    </div>

    @if (!Model.Jobs.Any())
    {
        <article class="info-card empty-state">
            <div class="card-kicker">No jobs yet</div>
            <h3>Queue a remediation to start building the background execution trail</h3>
            <p>The worker will pick up queued remediations here, record retries when needed, and then hand off the final outcome into the remediation run history below.</p>
        </article>
    }
    else
    {
        <div class="table-card">
            <table class="table table-dark align-middle mb-0 recommendation-table">
                <thead>
                    <tr>
                        <th scope="col">Status</th>
                        <th scope="col">Job</th>
                        <th scope="col">Progress</th>
                        <th scope="col">Timing</th>
                        <th scope="col">Latest detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Jobs)
                    {
                        <tr>
                            <td><span class="status-badge @GetJobStatusClass(job.Status)">@job.Status</span></td>
                            <td>
                                <div class="fw-semibold">@job.TemplateName</div>
                                <div class="table-subtext">@job.ConnectionDisplayName</div>
                            </td>
                            <td>
                                <div>Attempt @job.AttemptCount of @job.MaxAttempts</div>
                                <div class="table-subtext">Approval: @job.ApprovalJustification</div>
                                <div class="table-subtext">Launch mode: @job.LaunchMode</div>
                                <div class="table-subtext">Include: @(string.IsNullOrWhiteSpace(job.IncludeGroupId) ? "All users" : job.IncludeGroupId)</div>
                                @if (!string.IsNullOrWhiteSpace(job.ExcludeGroupId))
                                {
                                    <div class="table-subtext">Exclude: @job.ExcludeGroupId</div>
                                }
                            </td>
                            <td>
                                <div>Queued @job.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                @if (job.StartedUtc.HasValue)
                                {
                                    <div class="table-subtext">Started @job.StartedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                @if (job.NextAttemptUtc.HasValue && job.Status == RemediationJobStatus.RetryScheduled)
                                {
                                    <div class="table-subtext">Retry @job.NextAttemptUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                @if (job.CompletedUtc.HasValue)
                                {
                                    <div class="table-subtext">Finished @job.CompletedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                }
                            </td>
                            <td>
                                <div>@(job.Logs.LastOrDefault() ?? job.LastError ?? "No detail recorded.")</div>
                                @if (!string.IsNullOrWhiteSpace(job.PolicyId))
                                {
                                    <div class="table-subtext">Policy ID: @job.PolicyId</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="content-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Completed runs</span>
            <h2>Remediation run history</h2>
        </div>
    </div>

    @if (!Model.Runs.Any())
    {
        <article class="info-card empty-state">
            <div class="card-kicker">No completed runs yet</div>
            <h3>The worker has not finished a remediation yet</h3>
            <p>Once a queued job completes, the final execution record with policy details and per-step logs will appear here.</p>
        </article>
    }
    else
    {
        <div class="table-card">
            <table class="table table-dark align-middle mb-0 recommendation-table">
                <thead>
                    <tr>
                        <th scope="col">Status</th>
                        <th scope="col">Template</th>
                        <th scope="col">Connection</th>
                        <th scope="col">When</th>
                        <th scope="col">Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in Model.Runs)
                    {
                        <tr>
                            <td><span class="status-badge @GetStatusClass(run.Status)">@run.Status</span></td>
                            <td>
                                <div class="fw-semibold">@run.TemplateName</div>
                                <div class="table-subtext">@run.TemplateKey</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@run.ConnectionDisplayName</div>
                                <div class="table-subtext">Approval: @run.ApprovalJustification</div>
                                <div class="table-subtext">Launch mode: @run.LaunchMode</div>
                                <div class="table-subtext">Include: @(run.IncludeGroupName ?? (string.IsNullOrWhiteSpace(run.IncludeGroupId) ? "All users" : run.IncludeGroupId))</div>
                                @if (!string.IsNullOrWhiteSpace(run.ExcludeGroupId))
                                {
                                    <div class="table-subtext">Exclude: @(run.ExcludeGroupName ?? run.ExcludeGroupId)</div>
                                }
                            </td>
                            <td>
                                <div>@run.CompletedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                <div class="table-subtext">By @run.LaunchedByOperatorName</div>
                            </td>
                            <td>
                                <div>@run.Summary</div>
                                @if (!string.IsNullOrWhiteSpace(run.PolicyId))
                                {
                                    <div class="table-subtext">Policy ID: @run.PolicyId</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
