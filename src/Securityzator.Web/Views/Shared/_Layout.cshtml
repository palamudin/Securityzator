<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Securityzator</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Securityzator.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="top-shell">
        <nav class="navbar navbar-expand-lg">
            <div class="container-xxl">
                <a class="navbar-brand brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-dot"></span>
                    <span>Securityzator</span>
                </a>
                <button class="navbar-toggler nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Connections" asp-action="Index">Connections</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Recommendations" asp-action="Index">Recommendations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Remediations" asp-action="Index">Remediations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Jobs" asp-action="Index">Jobs</a>
                            </li>
                            <li class="nav-item shell-user">
                                <span class="shell-pill">@User.GetWorkspaceName()</span>
                                <span class="shell-pill role-pill">@User.GetOperatorRole()</span>
                                <span class="shell-user-name">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Create workspace</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xxl app-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-shell">
        <div class="container-xxl footer-content">
            <div>
                <strong>Securityzator</strong>
                <span>Milestone 5 worker-backed queue execution with auditable job history</span>
            </div>
            <div class="footer-copy">ASP.NET Core MVC web app + protected connection storage + Microsoft Graph remediation worker</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
