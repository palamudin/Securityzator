<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#06111a" />
    <title>@ViewData["Title"] - Securityzator</title>
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link href="https://fonts.bunny.net/css?family=inter:300,400,500,600,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Securityzator.Web.styles.css" asp-append-version="true" />
</head>
<body>
@{
    var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var isAuth = User.Identity?.IsAuthenticated == true;
}

@if (isAuth)
{
    <div class="app-wrapper">
        <aside class="app-sidebar" id="appSidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-dot"></span>
                <span class="brand-name">Securityzator</span>
            </a>
            <nav class="sidebar-nav">
                <a class="@(currentCtrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span class="nav-label">Dashboard</span>
                </a>
                <a class="@(currentCtrl == "Connections" ? "active" : "")" asp-controller="Connections" asp-action="Index">
                    <i class="bi bi-cloud-check"></i>
                    <span class="nav-label">Connections</span>
                </a>
                <a class="@(currentCtrl == "Recommendations" ? "active" : "")" asp-controller="Recommendations" asp-action="Index">
                    <i class="bi bi-shield-check"></i>
                    <span class="nav-label">Recommendations</span>
                </a>
                <a class="@(currentCtrl == "Remediations" ? "active" : "")" asp-controller="Remediations" asp-action="Index">
                    <i class="bi bi-lightning-charge"></i>
                    <span class="nav-label">Remediations</span>
                </a>
                <a class="@(currentCtrl == "Jobs" ? "active" : "")" asp-controller="Jobs" asp-action="Index">
                    <i class="bi bi-clock-history"></i>
                    <span class="nav-label">Jobs</span>
                </a>
            </nav>
            <div class="sidebar-footer">Securityzator</div>
        </aside>

        <div class="app-main" id="appMain">
            <header class="app-topbar">
                <button class="topbar-toggle" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
                <div class="topbar-end">
                    <span class="shell-pill">@User.GetWorkspaceName()</span>
                    <span class="shell-pill role-pill">@User.GetOperatorRole()</span>
                    <span class="topbar-user">@User.Identity!.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>Sign out
                        </button>
                    </form>
                </div>
            </header>
            <div class="app-content">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
}
else
{
    <div class="auth-page">
        <main role="main">
            @RenderBody()
        </main>
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    (function () {
        var toggle = document.getElementById('sidebarToggle');
        var sidebar = document.getElementById('appSidebar');
        var main = document.getElementById('appMain');
        if (!toggle || !sidebar) return;
        toggle.addEventListener('click', function () {
            var mini = sidebar.classList.toggle('sidebar-mini');
            if (main) main.classList.toggle('sidebar-mini', mini);
        });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
