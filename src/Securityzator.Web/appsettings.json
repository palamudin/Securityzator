{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Securityzator": {
    "HostingModel": "IIS",
    "GraphBaseUrl": "https://graph.microsoft.com/v1.0",
    "GraphBetaBaseUrl": "https://graph.microsoft.com/beta",
    "EnableBetaFallback": true,
    "AuthorityBaseUrl": "https://login.microsoftonline.com",
    "UseEnvironmentProxy": false,
    "QueueMode": "Background worker",
    "SecretStorage": "Server-side only",
    "Worker": {
      "HeartbeatStaleAfterSeconds": 30
    },
    "DataProtection": {
      "KeyRingPath": "App_Data/keyring"
    },
    "Storage": {
      "DataFilePath": "App_Data/securityzator-state.json",
      "MutexName": "Local\\Securityzator.StateStore"
    }
  }
}
